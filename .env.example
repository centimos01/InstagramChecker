# ===== Instagram =====
# Cuenta que quieres auditar (obligatorio).
INSTAGRAM_USERNAME=tu_usuario

# Contraseña: SOLO se usa para el primer login (genera session.json en el
# volumen) o si la sesión caduca. Después puedes dejarla vacía.
INSTAGRAM_PASSWORD=

# ===== 2FA del primer login (solo si la cuenta tiene 2FA activado) =====
# Opción A (recomendada, automática): seed TOTP base32 que usa tu app
# autenticadora (el "secret key" del QR/otpauth). Genera el código solo.
INSTAGRAM_OTP_SEED=
# Opción B (manual, de un solo uso): el código de 6 dígitos actual de tu app
# autenticadora o el SMS. Sirve solo para esa primera ejecución.
INSTAGRAM_2FA_CODE=
# Tras generar session.json puedes vaciar AMBAS (y también la contraseña).

# ===== Discord =====
# Token del Bot de Discord (https://discord.com/developers/applications).
DISCORD_BOT_TOKEN=
# ID numérico del canal donde se publican las alertas.
DISCORD_CHANNEL_ID=
# ID numérico del canal donde se suben los ZIPs de Instagram Data Download
# (opcional; si se configura, el bot monitoriza el canal automáticamente).
DISCORD_IMPORT_CHANNEL=

# ===== Auditoría =====
# Las comprobaciones se lanzan manualmente con /check desde Discord.
# También puedes ejecutar una pasada con: docker compose exec instagram-checker python main.py --once

# ¿Avisar también cuando un perfil que NO sigues te deja de seguir?
# false (por defecto): solo avisa cuando tú sigues a alguien y ya no te sigue.
# true: además avisa de perfiles que te seguían y te dejaron aunque tú no los siguieras.
NOTIFY_NON_FOLLOWING_UNFOLLOWS=false

# ===== Rutas (dentro del contenedor; no las cambies salvo que sepas) =====
SESSION_FILE=/data/session.json
DB_FILE=/data/audit.db

# ===== Opcional =====
TZ=Europe/Madrid
